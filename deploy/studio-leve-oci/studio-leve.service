[Unit]
Description=Arquivo Sombrio Studio Leve 1.3.2 (Streamlit original)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=arquivostudio
Group=arquivostudio
WorkingDirectory=/opt/arquivo-sombrio-studio
Environment=HOME=/opt/arquivo-sombrio-studio
Environment=IMAGEIO_FFMPEG_EXE=/usr/bin/ffmpeg
Environment=STREAMLIT_SERVER_HEADLESS=true
Environment=STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
ExecStart=/opt/arquivo-sombrio-studio/.venv/bin/python -m streamlit run /opt/arquivo-sombrio-studio/studio_app.py --server.address=127.0.0.1 --server.port=8502 --server.headless=true --server.maxUploadSize=100 --server.fileWatcherType=none --server.enableCORS=true --server.enableXsrfProtection=true
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/arquivo-sombrio-studio/storage
ProtectHome=true

[Install]
WantedBy=multi-user.target
